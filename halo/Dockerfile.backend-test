# Halo backend test image: the Halo backend image plus Plane's test tools (not deployed).
# halo/test-backend.sh builds it; with --dev it starts from the upstream image and the source is mounted.
ARG BASE_IMAGE=plane-backend-halo:v1.4.2-pages.2
FROM ${BASE_IMAGE}
COPY requirements-halo.txt /tmp/requirements-halo.txt
# Plane's requirements/test.txt pins; only the packages its tests import (no compilers in this image).
RUN pip install --no-cache-dir --no-deps --require-hashes -r /tmp/requirements-halo.txt \
    && pip install --no-cache-dir "pytest==9.0.3" "pytest-django==4.12.0" "pytest-mock==3.11.1" \
       "factory-boy==3.3.0" "freezegun==1.2.2"
WORKDIR /code
